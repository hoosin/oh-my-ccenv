bailian	Coding Plan	coding.dashscope.aliyuncs.com/apps/anthropic
deepseek	standard	api.deepseek.com
bailing	standard	openrouter.ai/api
mimo	standard	token-plan-cn.xiaomimimo.com/anthropic
.TE
.SH FILES
.TP
.I ~/.config/ccenv/profiles/*.toml
Profile files.
.TP
.I ~/.config/ccenv/current
Current profile name (plain text).
.TP
.I ~/.config/ccenv/stats.cache.json
Incremental stats cache.
.SH EXAMPLES
.PP
.nf
# Set a token and go
export DEEPSEEK_API_KEY="sk-..."
ccenv deepseek

# Interactive picker
ccenv

# See token usage
ccenv stats --since 7d

# Create a custom profile
ccenv add work
.fi
